.{
    .load_rc = false,
    .plugins = .{.{
        .path = "../../zig-out/bin/habush-theme.wasm",
        .declares = .{ .context = true, .fs_read = true },
        .grants = .{ .context = true, .fs_read = true },
        // Only this checkout is readable; cd outside it omits Git information.
        .read_directory = "../..",
        .prompt = .{},
        .options = .{
            .{ "git", "true" },
            .{ "symbol", "❯" },
            .{ "cwd_color", "cyan" },
            .{ "success_color", "green" },
            .{ "failure_color", "red" },
        },
    }},
}
