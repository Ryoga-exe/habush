.{
    .load_rc = false,
    .plugins = .{.{
        .path = "../../zig-out/bin/habush-theme.wasm",
        .declares = .{ .context = true, .fs_read = true },
        .grants = .{ .context = true, .fs_read = true },
        // Only these metadata files, from cwd up to this workspace, are readable.
        .read_ancestors = .{
            .from = .cwd,
            .within = "../../..",
            .files = .{ ".git", ".git/HEAD" },
        },
        .prompt = .{},
        .options = .{
            .{ "git", "true" },
            .{ "symbol", "❯" },
            .{ "cwd_color", "cyan" },
            .{ "success_color", "green" },
            .{ "failure_color", "red" },
        },
    }},
}
