.{
    .load_rc = false,
    .prompt_context = .{ .git = true },
    .plugins = .{.{
        .path = "../../zig-out/bin/habush-theme.wasm",
        .prompt = .{},
        .options = .{
            .{ "symbol", "❯" },
            .{ "cwd_color", "cyan" },
            .{ "success_color", "green" },
            .{ "failure_color", "red" },
        },
    }},
}
